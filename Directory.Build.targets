<Project>

  <!--
    Colocated tests: *.Tests.cs files live next to the source file they test, but compile into the test project
    (linked via a glob in Idioma.Tests.csproj), never into the source project itself. The None item keeps them
    visible in the IDE, nested under their subject (Foo.Tests.cs -> Foo.cs). Verify snapshots sit next to the test
    file as <TestFileName>.<Method>.verified.<ext> (see VerifySettings.DerivePathInfo), and nest under it.
  -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <Compile Remove="**/*.Tests.cs" />
    <!-- C# snapshots (generated-source verifications) would otherwise match the default Compile glob. -->
    <Compile Remove="**/*.verified.cs;**/*.received.cs" />
    <None Include="**/*.Tests.cs" Exclude="$(DefaultItemExcludes)">
      <_Subject>$([System.String]::Copy('%(Filename)').Replace('.Tests', ''))</_Subject>
      <DependentUpon>%(_Subject).cs</DependentUpon>
    </None>
    <None Update="**/*.Tests.*.verified.*;**/*.Tests.*.received.*" Pack="false" DependentUpon="$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)', '\.[^.]+\.(verified|received)$', '')).cs" />
  </ItemGroup>

</Project>
