<Project>

  <PropertyGroup>
    <AssemblyName>CodeChops.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>CodeChops.$(MSBuildProjectName)</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <NuGetAudit>true</NuGetAudit>
    <!-- Packing is opt-in: only src/Idioma ships. -->
    <IsPackable>false</IsPackable>
    <!-- The version of the package, here for every project: the generator and the code fixes ship inside the package,
         and an IDE or a compiler server that has loaded them from one version of it tells them from those of the next
         by their assembly version. Without it both stood at 1.0.0.0 in every package. -->
    <Version>0.14.0</Version>
  </PropertyGroup>

  <!-- A build on CI is deterministic, so the package's symbols map to the sources on GitHub (Source Link). -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
