<Project>
  <ItemGroup>
    <!-- Code analysis and analyzers -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.318" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- The tests compile against this version; the generator pins its own, older one (see Idioma.Generators.csproj). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Testing packages -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="TUnit" Version="1.76.28" />
    <!-- Verify is pinned with exact ranges on purpose. Every release from the VerifyTests organization after
         1 September 2026 falls under the maintainer's paid Open Source Maintenance Fee (a build-time SponsorCheck from
         Verify 33 onward); 32.0.0 (26 August 2026) is the last stable release before that line. DiffEngine and
         EmptyFiles are published by the same organization and are only transitive (via Verify), so the test project
         references them directly to pin them. Do not bump without buying a sponsorship. -->
    <PackageVersion Include="Verify" Version="[32.0.0]" />
    <PackageVersion Include="Verify.TUnit" Version="[32.0.0]" />
    <PackageVersion Include="DiffEngine" Version="[20.3.1]" />
    <PackageVersion Include="EmptyFiles" Version="[8.18.2]" />
  </ItemGroup>
</Project>
