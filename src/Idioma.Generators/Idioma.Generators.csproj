<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The source generator and analyzers of CodeChops.Idioma, packed into its analyzers folder (see Idioma.csproj).
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DevelopmentDependency>true</DevelopmentDependency>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>MA0051, RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Pinned to the compiler of the first .NET 10 SDK (10.0.100), not the central version: a compiler skips an analyzer
      built against a newer Roslyn than its own (CS9057), and then LocalizableText.Translated vanishes from every build
      of a consumer on an older SDK. C# 14 extension members, which the generated factory uses, need this compiler
      anyway. A bulk package update in Rider rewrites VersionOverride too: put it back.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" VersionOverride="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeChops.Idioma.Tests" />
  </ItemGroup>

</Project>
