<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Texts for any .NET app, Blazor or not. The package has no dependencies, and must keep none: tests/Idioma.Tests
    fails when one creeps in (PackageIndependenceTests).
  -->

  <PropertyGroup Label="Main">
    <!-- One framework: the package depends on nothing framework-specific, so a newer runtime uses this build as is.
         The tests run on every supported runtime (see Idioma.Tests.csproj). -->
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Packages are produced by `dotnet pack` only, never on build: with GeneratePackageOnBuild set, NuGet's Pack target
    no longer depends on Build, so `dotnet pack` would pack whatever outputs happen to be on disk.
  -->
  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <Version>0.5.0</Version>
    <!-- Starts and ends on the lines of its tags, and stands at the margin: the package shows it space for space. -->
    <PackageReleaseNotes>The wording for a culture you pass is text.ToString(culture), next to ToString() for the user's own, where it was text.GetText(culture). The overload that also takes a registry is renamed with it.

A text without translations and without a key is written to JSON as its wording alone, such as "Anna", and a text without translations leaves "translations" out. JSON written by an earlier version still reads.

A text that falls back to a language shows what a user of that language sees: with zh-TW as the default language, it reaches a set for zh-Hant.

LOC004 says that a nested, generic, or file-local class does not count as a set, where it asked for a set that seemed to exist.

A generated text links a set that inherits its wording to the class that words it, such as ShopTranslationsEN.Checkout for a British set that leaves Checkout as it is. That link named the set, which a project writing a documentation file reported as CS1574.

A text named like a member every class has, such as Equals, no longer gives CS0108 in the generated class.

In an IDE, a set deriving from a set of another project that implements LanguageCode no longer stops the source generator.

A library that a Blazor WebAssembly app loads lazily works once it has loaded, and registers its sets when its code first runs. The app called the library's registrar at startup, and the WebAssembly runtime kept refusing the library afterwards. The app now looks the library up by name first.

The docs say that LOC011 starts with the second language an assembly declares, that the build rejects text.Equals("Naam") there, and which members throw on null.</PackageReleaseNotes>
    <PackageId>CodeChops.Idioma</PackageId>
    <Title>CodeChops.Idioma</Title>
    <Description>Translations for any .NET app, written in C#: a class per language, or inline texts, where a missing translation is a compile error. No resource files, no reflection, trimming-safe.</Description>
    <PackageTags>CodeChops;Idioma;localization;translations;i18n;l10n;globalization;blazor;source-generator;sourcegenerator;aot;trimming</PackageTags>
    <PackageProjectUrl>https://github.com/code-chops/Idioma</PackageProjectUrl>
    <RepositoryUrl>https://github.com/code-chops/Idioma</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Authors>CodeChops (@Code-Chops), Max Bergman</Authors>
    <Company>CodeChops</Company>
    <Copyright>Copyright (c) CodeChops $([System.DateTime]::Now.ToString(yyyy))</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Symbols go into a separate .snupkg, with the sources that are not in git (generated code) embedded. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup Label="PackageAssets">
    <!-- The license file is packed next to the license expression for its closing sentence on generated code. -->
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
    <!-- The generator ships in the package's analyzers folder. A literal path, not a glob: a glob evaluates before
         the generator builds and would silently pack nothing, where a missing file fails the pack. -->
    <None Include="..\Idioma.Generators\bin\$(Configuration)\netstandard2.0\CodeChops.Idioma.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Its code fixes, in an assembly of their own: they need the workspaces API, which a compiler does not carry. -->
    <None Include="..\Idioma.CodeFixes\bin\$(Configuration)\netstandard2.0\CodeChops.Idioma.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Shows the generator whether the project is an Android app (see the file). In both folders: NuGet reads build
         for a project that references the package itself, and buildTransitive for one that gets it through another.
         Removed and included again by its path: the item the SDK includes by itself would land in build/build. -->
    <None Remove="build\CodeChops.Idioma.props" />
    <None Include="build\CodeChops.Idioma.props" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the generator before this project, and runs it on this project's own code. -->
    <ProjectReference Include="..\Idioma.Generators\Idioma.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Only built before this project, for the pack: a build runs no code fix. -->
    <ProjectReference Include="..\Idioma.CodeFixes\Idioma.CodeFixes.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
