<Project>

  <!--
    Shows the source generator which project is the app when it builds as a library. The compiler's output kind takes
    such a project for a library, and the app's languages would not register when it starts.
    - AndroidApplication: the Android SDK builds an app as a library (it turns OutputType Exe into Library, as an app has
      no Main). The SDK's own property tells the two apart: true for an app, false for a library.
    - IdiomaApplication: a project that a host loads, such as an AWS Lambda function, sets it to true itself.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="AndroidApplication" />
    <CompilerVisibleProperty Include="IdiomaApplication" />
  </ItemGroup>

</Project>
