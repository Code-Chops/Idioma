<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    An app with 100 texts in English and Dutch, as sets of Idioma and as resx files for IStringLocalizer, for the download
    sizes of docs/performance.md. run.sh publishes it twice: with English only (-p:SecondLanguage=false), and with Dutch
    too. What the second publish adds is what a language of 100 texts costs. The app is published, never run.
  -->

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <SecondLanguage Condition="'$(SecondLanguage)' == ''">true</SecondLanguage>
    <!-- Each variant builds into folders of its own, so that no build of one is taken for the other. Set here, because
         on the command line they would apply to the referenced projects too, which then embed other paths. -->
    <SizeVariant>second-language-$(SecondLanguage)-aot-$(RunAOTCompilation)</SizeVariant>
    <IntermediateOutputPath>obj/$(Configuration)/$(SizeVariant)/</IntermediateOutputPath>
    <OutputPath>bin/$(Configuration)/$(SizeVariant)/</OutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(SecondLanguage)' == 'true'">
    <Compile Remove="OneLanguage.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(SecondLanguage)' != 'true'">
    <Compile Remove="TwoLanguages.cs;StoreLocalizationNl.cs" />
    <EmbeddedResource Remove="Store.nl.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="11.0.0" />
    <ProjectReference Include="../../src/Idioma/Idioma.csproj" />
    <ProjectReference Include="../../src/Idioma.Generators/Idioma.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
