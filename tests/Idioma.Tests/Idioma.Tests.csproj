<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of CodeChops.Idioma, on every supported runtime.
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>MA0003;$(NoWarn);</NoWarn> <!-- Add parameter name to improve readability - not necessary for tests -->
    <NoWarn>MA0004;$(NoWarn);</NoWarn> <!-- Use Task.ConfigureAwait - not necessary for tests -->
    <NoWarn>MA0048;$(NoWarn);</NoWarn> <!-- File name must match type name - a fixture the generators must discover cannot nest -->
    <NoWarn>LOC011;LOC012;LOC013;$(NoWarn);</NoWarn> <!-- A test compares texts with plain strings, and reaches what only generated code should call -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Colocated tests: *.Tests.cs files live next to their subject in the source project (see Directory.Build.targets). -->
    <Compile Include="..\..\src\Idioma\**\*.Tests.cs" Exclude="..\..\src\Idioma\bin\**;..\..\src\Idioma\obj\**" LinkBase="Idioma" />
    <Compile Include="..\..\src\Idioma.Generators\**\*.Tests.cs" Exclude="..\..\src\Idioma.Generators\bin\**;..\..\src\Idioma.Generators\obj\**" LinkBase="Idioma.Generators" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Verify" />
    <PackageReference Include="Verify.TUnit" />
    <!-- Direct references only to pin the VerifyTests-organization transitives (see Directory.Packages.props). -->
    <PackageReference Include="DiffEngine" />
    <PackageReference Include="EmptyFiles" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Idioma\Idioma.csproj" />
    <!-- Both: an analyzer for the fixtures in GeneratedSets.Tests.cs, and a reference for the tests of the generator itself. -->
    <ProjectReference Include="..\..\src\Idioma.Generators\Idioma.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
